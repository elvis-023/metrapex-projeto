# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=

# PDFMonkey
PDFMONKEY_API_KEY=
# Usado quando a organização não tem pdf_settings.pdfmonkey_template_id próprio.
PDFMONKEY_DEFAULT_TEMPLATE_ID=

# n8n
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Segredo que o n8n envia (Authorization: Bearer) ao chamar de volta
# /api/automations/follow-up, /api/automations/expire-quotes (Milestone 18) e
# /api/automations/send-reports (Milestone 20) — direção inversa do par
# acima, não reutilizar o mesmo valor.
AUTOMATIONS_API_SECRET=

# BrasilAPI / ViaCEP
# Sem chave — APIs públicas sem autenticação.

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
